# MAESTA Chatbot Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# Flask Configuration
# ===========================================
FLASK_ENV=production
SECRET_KEY=your-super-secret-key-change-this-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ===========================================
# Database
# ===========================================
DATABASE_PATH=/app/data/chatbot.db

# ===========================================
# Ollama LLM Service
# ===========================================
OLLAMA_BASE_URL=http://ollama:11434

# ===========================================
# Redis Cache (Optional)
# ===========================================
REDIS_URL=redis://redis:6379

# ===========================================
# AI Model Configuration
# ===========================================
DEFAULT_MODEL=qwen3:1.7b
EMBEDDING_MODEL=nomic-embed-text:latest
USE_OLLAMA_EMBEDDING=true

# ===========================================
# API Settings
# ===========================================
API_KEY_LENGTH=32
RATE_LIMIT_PER_MINUTE=60

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=INFO
LOG_TO_FILE=false

# ===========================================
# Sentry (Optional - Error Tracking)
# ===========================================
SENTRY_DSN=
ENABLE_SENTRY=false

# ===========================================
# Web Crawling Settings
# ===========================================
MAX_CRAWL_DEPTH=2
MAX_CRAWL_PAGES=100
CRAWL_DELAY_SECONDS=1.0
CRAWL_TIMEOUT_SECONDS=30

# ===========================================
# Agent Settings
# ===========================================
USE_AGENT=true
LLM_GENERATION_TIMEOUT=400
AGENT_TIMEOUT=400
MAX_ITERATIONS=5

# ===========================================
# Dual-LLM (Gemini) Settings
# ===========================================
GEMINI_API_KEY=
GEMINI_FLASH_MODEL=gemini-2.0-flash
GEMINI_PRO_MODEL=gemini-2.5-pro-preview-05-06
ENABLE_GEMINI_VERIFICATION=true
ENABLE_DUAL_LLM=true
PRIORITIZE_LOCAL=true

# ===========================================
# Interview System Settings
# ===========================================
INTERVIEW_WEIGHT_TECHNICAL=0.35
INTERVIEW_WEIGHT_PRACTICAL=0.20
INTERVIEW_WEIGHT_EXPERIENCE=0.15
INTERVIEW_WEIGHT_CONSISTENCY=0.15
INTERVIEW_WEIGHT_COMMUNICATION=0.10
INTERVIEW_WEIGHT_TRUST=0.05

INTERVIEW_THRESHOLD_STRONG_HIRE=90
INTERVIEW_THRESHOLD_HIRE=80
INTERVIEW_THRESHOLD_MAYBE=65
INTERVIEW_THRESHOLD_WEAK_HIRE=50

INTERVIEW_MAX_FOLLOWUPS=3
INTERVIEW_QUESTIONS_PER_SKILL=3
INTERVIEW_DEFAULT_LLM_MODEL=qwen3:1.7b
INTERVIEW_ENABLED=true
INTERVIEW_ENABLE_CHALLENGES=true
INTERVIEW_ENABLE_ANTI_CHEAT=true
INTERVIEW_ENABLE_REDIS=false