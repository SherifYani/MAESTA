# ============================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================
# Copy this file to .env and fill in your values

# TensorFlow settings (to suppress noisy logs)
TF_ENABLE_ONEDNN_OPTS=0
TF_CPP_MIN_LOG_LEVEL=2

# ============================================
# Ollama Configuration
# ============================================
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_MODEL=qwen3:8b

# ============================================
# Embedding Model Configuration
# ============================================
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ============================================
# Document Processing
# ============================================
CHUNK_SIZE=512
CHUNK_OVERLAP=50
MAX_UPLOAD_SIZE_MB=50

# ============================================
# Search Configuration
# ============================================
TOP_K_RESULTS=5

# Document chunks to use for generation (reduce for faster responses with small models)
MAX_DOCUMENT_CHUNKS=2

# ============================================
# Ollama Generation Timeout
# ============================================
# Timeout in seconds for AI generation (increase for slower models or document-based responses)
OLLAMA_GENERATION_TIMEOUT=600

# ============================================
# Memory/Conversation Settings
# ============================================
MAX_CONVERSATION_HISTORY=10
SESSION_TIMEOUT_MINUTES=30

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
LOG_TO_FILE=false

# ============================================
# Flask Application Settings
# ============================================
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=your-secret-key-here-change-in-production

# ============================================
# Database Configuration
# ============================================
DATABASE_PATH=data/chatbot.db

# ============================================
# Dual-LLM (Gemini) Configuration
# ============================================
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY="AIzaSyDlDl0jWbCZUAVl-cGUIiR9ZHqtqkxGJKI"
GEMINI_FLASH_MODEL=gemini-2.0-flash
GEMINI_PRO_MODEL=gemini-2.5-pro-preview-05-06
ENABLE_DUAL_LLM=true
ENABLE_GEMINI_VERIFICATION=true

# ============================================
# Claude (AgentRouter) Configuration
# ============================================
# Get your API key from: https://agentrouter.org/console/token
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-opus-4-6
CLAUDE_BASE_URL=https://agentrouter.org/v1
# Cloud provider: "gemini", "claude", or "auto"
CLOUD_PROVIDER=gemini

# ============================================
# Fine-Tuned / HF Space Model Configuration
# ============================================
# Option A: Hugging Face Space (Qwen3 1.7B API)
# Space URL: https://aboamin27-maesta-qwen3-1-7b-api.hf.space
USE_FINETUNED_MODEL=true
FINETUNED_MODEL_BASE_URL=https://aboamin27-maesta-qwen3-1-7b-api.hf.space/v1
FINETUNED_MODEL_NAME=qwen3-1.7b
FINETUNED_MODEL_API_KEY=YOUR_LLM_API_TOKEN_HERE
COMPANY_ASSISTANT_MODE=true

# Option B: Local llama.cpp server (fallback)
# FINETUNED_MODEL_BASE_URL=http://localhost:8082/v1
# FINETUNED_MODEL_NAME=qwen3-company-assistant
# FINETUNED_MODEL_API_KEY=not-needed
# FINETUNED_LLAMA_PORT=8082

# ============================================
# Utility Model Configuration
# ============================================
# يستخدم لعمليات RAG المساعدة (scoring, routing)
USE_UTILITY_LLM=true
UTILITY_MODEL_BASE_URL=https://aboamin27-maesta-qwen3-1-7b-api.hf.space/v1
UTILITY_MODEL_NAME=qwen3-1.7b
UTILITY_MODEL_API_KEY=YOUR_LLM_API_TOKEN_HERE
